rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'julia.sggomes@gmail.com';
    }

    function isAdminRecord() {
      return isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdmin() {
      return isBootstrappedAdmin() || isAdminRecord();
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt'])
        && data.keys().hasOnly(['email', 'role', 'createdAt'])
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.role == 'admin'
        && data.createdAt is timestamp;
    }

    function isValidPortfolioProject(data, projectId) {
      return data.keys().hasAll([
          'id', 'title', 'cat', 'tag', 'desc', 'cover',
          'order', 'chunkCount', 'ownerId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'cat', 'tag', 'desc', 'cover',
          'order', 'chunkCount', 'ownerId', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == projectId && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.cat in ['clinicas', 'restaurantes', 'escritorios', 'empresas']
        && data.tag is string && data.tag.size() >= 1 && data.tag.size() <= 120
        && data.desc is string && data.desc.size() >= 1 && data.desc.size() <= 1500
        && data.cover is string && data.cover.size() <= 500000
        && data.order is int && data.order >= 0 && data.order <= 10000
        && data.chunkCount is int && data.chunkCount >= 0 && data.chunkCount <= 30
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProjectChunk(data) {
      return data.keys().hasAll(['index', 'data', 'ownerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['index', 'data', 'ownerId', 'createdAt', 'updatedAt'])
        && data.index is int && data.index >= 0 && data.index <= 30
        && data.data is string && data.data.size() >= 1 && data.data.size() <= 600000
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /admins/{adminId} {
      allow get: if isVerifiedUser() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(adminId)
        && isValidAdminUser(incoming())
        && incoming().createdAt == request.time
        && isAdmin();
      allow update: if isVerifiedUser()
        && isValidId(adminId)
        && isValidAdminUser(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'role'])
        && isAdmin();
      allow delete: if isVerifiedUser() && isValidId(adminId) && isAdmin();
    }

    match /projects/{projectId} {
      allow get: if isValidId(projectId);
      allow list: if request.query.limit is int && request.query.limit <= 100;
      allow create: if isVerifiedUser()
        && isValidId(projectId)
        && isValidPortfolioProject(incoming(), projectId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isVerifiedUser()
        && isValidId(projectId)
        && isValidPortfolioProject(incoming(), projectId)
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['order', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'cat', 'tag', 'desc', 'cover', 'order', 'chunkCount', 'updatedAt'
          ])
        )
        && isAdmin();
      allow delete: if isVerifiedUser() && isValidId(projectId) && isAdmin();

      match /chunks/{chunkId} {
        allow get: if isValidId(projectId) && isValidId(chunkId);
        allow list: if isValidId(projectId) && request.query.limit is int && request.query.limit <= 50;
        allow create: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(chunkId)
          && isValidProjectChunk(incoming())
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isAdmin()
          && existsAfter(/databases/$(database)/documents/projects/$(projectId))
          && getAfter(/databases/$(database)/documents/projects/$(projectId)).data.id == projectId;
        allow update: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(chunkId)
          && isValidProjectChunk(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['index', 'data', 'updatedAt'])
          && isAdmin()
          && exists(/databases/$(database)/documents/projects/$(projectId))
          && get(/databases/$(database)/documents/projects/$(projectId)).data.id == projectId;
        allow delete: if isVerifiedUser() && isValidId(projectId) && isValidId(chunkId) && isAdmin();
      }
    }
  }
}
